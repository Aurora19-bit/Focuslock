<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp">

    <TextView
        android:id="@+id/puzzleTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Solve to confirm uninstall"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/puzzleProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="14sp"
        android:textColor="#888888" />

    <TextView
        android:id="@+id/puzzleQuestion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:textSize="32sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/puzzleAnswer"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:inputType="numberSigned"
        android:gravity="center"
        android:textSize="24sp" />

    <TextView
        android:id="@+id/puzzleFeedback"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="#E94560" />

    <Button
        android:id="@+id/puzzleSubmit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Submit" />

    <Button
        android:id="@+id/puzzleCancel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Cancel, keep FocusLock"
        style="?android:attr/borderlessButtonStyle" />

</LinearLayout>
